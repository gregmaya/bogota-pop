# The pipeline DAG (ADR-0010). Run from the repo root:
#
#   uv run snakemake -s pipeline/Snakefile -c1                      # build everything
#   uv run snakemake -s pipeline/Snakefile -n                       # dry run: what would run, and why
#   uv run snakemake -s pipeline/Snakefile -c1 --config vigencia=2027
#
# Each rule calls one `bogota-pop` stage; the CLI stays the single entry point.
# Output is shown in the terminal and kept in data/logs/{vigencia}/<stage>.log.
# Snakemake runs shell commands with `set -euo pipefail`, so a failing stage
# still fails the pipeline even though its output is piped through tee.
# Ingest writes one GeoParquet per source. The later stages are still stubs that
# write marker files; each phase replaces its marker with real outputs.

from pathlib import Path

import yaml

VIGENCIA = str(config.get("vigencia", "2026"))


def code(*stages):
    """Source files of the given stages plus the CLI.

    Listed as rule inputs so that editing a stage's code re-runs that stage and
    everything downstream (Snakemake only watches the Snakefile's own commands).
    """
    files = ["src/bogota_pop/cli.py"]
    for stage in stages:
        files += sorted(str(f) for f in Path("src/bogota_pop", stage).rglob("*.py"))
    return files


rule all:
    input:
        f"data/processed/{VIGENCIA}/.publish.done",


# ── Ingest (ADR-0012) ─────────────────────────────────────────────────────────
# One job per source, so a change to one source re-runs only that source.
# A source joins the DAG once its download_url is filled in sources.yaml.
# Each source keeps its own vigencia (MGN is 2018 whatever the run's vigencia).

# `--config offline=1` leaves every source out, so nothing is downloaded. CI uses
# it: CI never downloads full datasets (CLAUDE.md rule 8); tests cover ingest.

SOURCES = yaml.safe_load(Path("config/sources.yaml").read_text(encoding="utf-8"))["sources"]
OFFLINE = bool(int(config.get("offline", 0)))
READY = {} if OFFLINE else {sid: s for sid, s in SOURCES.items() if s["download_url"]}


def interim(source_id):
    return f"data/interim/{source_id}/{READY[source_id]['vigencia']}.parquet"


wildcard_constraints:
    source_id="[a-z][a-z0-9_]*",


rule ingest_source:
    input:
        code("ingest"),
    output:
        "data/interim/{source_id}/{source_vigencia}.parquet",
    params:
        # Re-run when this source's entry in sources.yaml changes, and only then.
        entry=lambda w: SOURCES[w.source_id],
    log:
        "data/logs/ingest/{source_id}-{source_vigencia}.log",
    shell:
        "bogota-pop ingest {wildcards.source_id} 2>&1 | tee {log}"


rule ingest:
    input:
        [interim(sid) for sid in READY],
        code("harmonise"),
    output:
        touch("data/interim/{vigencia}/.ingest.done"),


rule model:
    input:
        "data/interim/{vigencia}/.ingest.done",
        code("model"),
    output:
        touch("data/processed/{vigencia}/.model.done"),
    log:
        "data/logs/{vigencia}/model.log",
    shell:
        "bogota-pop model 2>&1 | tee {log}"


rule validate:
    input:
        "data/processed/{vigencia}/.model.done",
        code("validate"),
    output:
        touch("data/processed/{vigencia}/.validate.done"),
    log:
        "data/logs/{vigencia}/validate.log",
    shell:
        "bogota-pop validate 2>&1 | tee {log}"


rule publish:
    input:
        "data/processed/{vigencia}/.model.done",
        "data/processed/{vigencia}/.validate.done",
        code("publish"),
    output:
        touch("data/processed/{vigencia}/.publish.done"),
    log:
        "data/logs/{vigencia}/publish.log",
    shell:
        "bogota-pop publish 2>&1 | tee {log}"
